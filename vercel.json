{
  "functions": {
    "api/applications.ts": { "maxDuration": 60 },
    "api/retry-applications.ts": { "maxDuration": 120 }
  },
  "crons": [{ "path": "/api/retry-applications", "schedule": "*/5 * * * *" }],
  "redirects": [
    {
      "source": "/transmission",
      "destination": "/transmission/gear/",
      "permanent": false
    },
    {
      "source": "/hardware",
      "destination": "/hardware/tube-plugs/",
      "permanent": false
    },
    {
      "source": "/structure",
      "destination": "/structure/tube/",
      "permanent": false
    },
    {
      "source": "/wheels",
      "destination": "/wheels/silicone-wheel/",
      "permanent": false
    }
  ]
}
