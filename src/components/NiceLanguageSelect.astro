---
import { Languages } from '@lucide/astro';
import { labels, locales, splitPath, type Locale } from '../i18n/locales';
import status from '../i18n/translation-status.json';

const { locale, path } = splitPath(Astro.url.pathname);
const pageId = path.replace(/^\/|\/$/g, '') || 'index';
const pages = status as Record<string, { anchors: Record<Locale, string[]> }>;
const anchors = pages[pageId]?.anchors ?? {};
---

<script is:inline>
  // Capture input before the deferred language module has downloaded.
  for (const event of ['pointerdown', 'keydown', 'touchstart', 'wheel']) {
    window.addEventListener(event, () => { document.documentElement.dataset.niceLanguageInteracted = 'true'; }, { once: true, passive: true });
  }
</script>

<label class="nice-language-control">
  <Languages size={18} aria-hidden="true" />
  <select aria-label={Astro.locals.t('languageSelect.accessibleLabel')}
    data-language-select data-locale={locale} data-anchors={JSON.stringify(anchors)}>
    {locales.map((value) => <option value={value} selected={value === locale}>{labels[value]}</option>)}
  </select>
</label>

<script>
  import '../scripts/language';
</script>

<style>
  .nice-language-control {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding-inline: 0.55rem 0.3rem;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 0.375rem;
    color: white;
    flex-shrink: 0;
  }
  select {
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    background: transparent;
    border: 0;
    color: inherit;
    min-height: 2.1rem;
    max-width: 7.5rem;
  }
  option { color: #242424; background: white; }
  .nice-language-control:focus-within { outline: 2px solid white; outline-offset: 3px; }
  select:focus-visible { outline: none; }
</style>
