---
interface Props {
	href?: string;
	label?: string;
	title?: string;
}

const { href, label = Astro.locals.t('nice.buy'), title = label } = Astro.props;
const classes =
	'nice-buy-button not-content inline-flex size-9 shrink-0 items-center justify-center whitespace-nowrap rounded-lg border border-[#fc5000] bg-[#fc5000] align-middle text-white no-underline transition-colors duration-200 hover:border-[#c93e00] hover:bg-[#c93e00] hover:text-white';
---

{
	href ? (
		<a class={classes} href={href} target="_blank" rel="noreferrer" aria-label={title}>
			<span
				class="size-[1.35rem] rounded-[0.1875rem] bg-current [mask:url('/assets/ui/taobao.svg')_center/contain_no-repeat] [-webkit-mask:url('/assets/ui/taobao.svg')_center/contain_no-repeat]"
				aria-hidden="true"
			/>
			<span class="sr-only">{label}</span>
		</a>
	) : null
}
