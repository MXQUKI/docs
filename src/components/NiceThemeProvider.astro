{/* Match the site's two-state theme toggle, including browsers that deny storage. */}
<script is:inline>
  (() => {
    let stored;
    try { stored = localStorage.getItem('starlight-theme'); } catch {}
    document.documentElement.dataset.theme = stored === 'light' || stored === 'dark'
      ? stored : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    window.StarlightThemeProvider = {
      updatePickers(theme = stored || 'auto') {
        document.querySelectorAll('starlight-theme-select select').forEach((select) => { select.value = theme; });
      },
    };
  })();
</script>
