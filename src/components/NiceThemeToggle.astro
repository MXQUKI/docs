---
import NiceIcon from './NiceIcon.astro';
---

<nice-theme-toggle>
	<button type="button" aria-label={Astro.locals.t('themeSelect.accessibleLabel')} title={Astro.locals.t('themeSelect.accessibleLabel')}>
		<NiceIcon name="bulb" size="1.45rem" strokeWidth="2.25" />
	</button>
</nice-theme-toggle>

<script>
	type Theme = 'dark' | 'light';

	const storageKey = 'starlight-theme';
	const themes: Theme[] = ['dark', 'light'];

	function getCurrentTheme(): Theme {
		return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
	}

	function setTheme(theme: Theme) {
		document.documentElement.dataset.theme = theme;
		try { localStorage.setItem(storageKey, theme); } catch { /* Private browsing may disable storage. */ }
	}

	class NiceThemeToggle extends HTMLElement {
		constructor() {
			super();
			this.querySelector('button')?.addEventListener('click', () => {
				const currentIndex = themes.indexOf(getCurrentTheme());
				setTheme(themes[(currentIndex + 1) % themes.length]);
			});
		}
	}

	customElements.define('nice-theme-toggle', NiceThemeToggle);
</script>

<style>
	@layer starlight.core {
		nice-theme-toggle {
			display: inline-flex;
		}

		nice-theme-toggle button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.35rem;
			height: 2.25rem;
			border: 0;
			border-radius: 0.375rem;
			background: transparent;
			color: white;
			cursor: pointer;
			transition: background-color 180ms ease;
		}

		nice-theme-toggle button:hover {
			background: rgba(255, 255, 255, 0.14);
			color: white;
		}

		:root[data-theme='light'] nice-theme-toggle :global(.nice-icon) {
			fill: currentColor;
		}

		:root[data-theme='dark'] nice-theme-toggle :global(.nice-icon) {
			fill: none;
		}
	}
</style>
