---
import niceBoxLogo from '../assets/logos/nice-box.svg?raw';
---

<footer class="nice-footer">
	<div class="nice-footer-brand" aria-hidden="true">
		<span class="nice-footer-logo" set:html={niceBoxLogo} />
	</div>
	<div class="nice-footer-contact">
		<h2>{Astro.locals.t('nice.contact')}</h2>
		<a href="mailto:contact@nicerobotics.hk">contact@nicerobotics.hk</a>
	</div>
	<p>Copyright © 2026 NICE Robotics Limited. All rights reserved.</p>
</footer>

<style>
	@layer starlight.core {
		.nice-footer {
			position: relative;
			z-index: 100;
			display: grid;
			grid-template-columns:
				minmax(0, 1fr)
				minmax(0, var(--sl-content-width))
				minmax(0, 1fr);
			align-items: start;
			gap: 1rem 2rem;
			box-sizing: border-box;
			inline-size: 100vw;
			margin-block-start: 3.5rem;
			margin-inline: calc(50% - 50vw);
			padding-block: 1.75rem 0.7rem;
			padding-inline: var(--nice-shell-edge);
			border-block-start: 1px solid var(--sl-color-hairline);
			background: var(--nice-content-bg);
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
		}

		.nice-footer-brand {
			position: absolute;
			inset-block-start: 1.75rem;
			inset-inline-start: var(--nice-shell-edge);
			display: flex;
			align-items: center;
			min-width: 0;
		}

		.nice-footer-logo {
			display: inline-flex;
			width: 3rem;
			height: 2.63rem;
			flex: 0 0 auto;
			color: var(--nice-header-bg, #fc5000);
		}

		.nice-footer-logo :global(svg) {
			display: block;
			width: 100%;
			height: 100%;
			overflow: visible;
		}

		.nice-footer-contact {
			grid-column: 2;
			justify-self: start;
			text-align: start;
		}

		.nice-footer h2 {
			margin: 0 0 0.375rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-sm);
			font-weight: 650;
			line-height: 1.35;
		}

		.nice-footer a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.nice-footer a:hover {
			color: var(--sl-color-text-accent);
			text-decoration: none;
		}

		.nice-footer p {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-self: center;
			margin: 0;
			font-size: 0.75rem;
			text-align: center;
		}

		@media (max-width: 50rem) {
			.nice-footer {
				grid-template-columns: 1fr;
				justify-items: center;
				gap: 0.75rem;
			}

			.nice-footer-brand,
			.nice-footer-contact,
			.nice-footer p {
				position: static;
				grid-column: 1;
				grid-row: auto;
				justify-self: center;
				text-align: center;
			}

			.nice-footer-contact {
				text-align: center;
			}
		}
	}
</style>
