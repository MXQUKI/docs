---
import config from 'virtual:starlight/user-config';

import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import NiceIcon from './NiceIcon.astro';
import NiceThemeToggle from './NiceThemeToggle.astro';
import NiceLanguageSelect from './NiceLanguageSelect.astro';
import { localizedPath, splitPath } from '../i18n/locales';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const { locale, path: pathname } = splitPath(Astro.url.pathname);
const t = Astro.locals.t;
const navItems: Array<{
	label: string;
	href: string;
	icon: string;
	match: (path: string) => boolean;
}> = [
	{ label: t('nice.home'), href: '/', icon: 'home', match: (path: string) => path === '/' },
	{
		label: t('nice.transmission'),
		href: '/transmission/gear/',
		icon: 'gear',
		match: (path: string) => path.startsWith('/transmission/'),
	},
	{
		label: t('nice.hardware'),
		href: '/hardware/tube-plugs/',
		icon: 'gem',
		match: (path: string) => path.startsWith('/hardware/'),
	},
	{
		label: t('nice.structure'),
		href: '/structure/tube/',
		icon: 'chimney',
		match: (path: string) => path.startsWith('/structure/'),
	},
	{
		label: t('nice.wheels'),
		href: '/wheels/silicone-wheel/',
		icon: 'truck-monster',
		match: (path: string) => path.startsWith('/wheels/'),
	},
];
---

<header class="nice-header">
	<div class="nice-brand-row">
		<div class="nice-brand-inner">
			<div class="title-wrapper">
				<SiteTitle />
			</div>
			<div class="nice-actions print:hidden">
				<NiceLanguageSelect />
				<div class="nice-header-controls">
					<div class="nice-social-icons">
						<SocialIcons />
					</div>
					<NiceThemeToggle />
				</div>
				<a
					class="nice-shop-link"
					href="https://nicerobotics.taobao.com/shop/view_shop.htm?appUid=RAzN8HWJdjiTsH6vMYrM9m1KNMFvi4PetiJdDkWp83MRuUBb3Jb&spm=a21n57.1.hoverItem.1"
					target="_blank"
					rel="noreferrer"
					aria-label={t('nice.shop')}
				>
					<span class="nice-shop-icon nice-taobao-icon" aria-hidden="true"></span>
				</a>
				<a
					class="nice-shop-link"
					href="https://cad.onshape.com/documents/ba7820e266bf07d2040335fc/w/3a4be06c69e78ddc646b65a4/e/7f22433f4e3029512ffe8385"
					target="_blank"
					rel="noreferrer"
					aria-label={t('nice.onshape')}
				>
					<span class="nice-shop-icon nice-onshape-icon" aria-hidden="true"></span>
				</a>
				{shouldRenderSearch && <Search />}
			</div>
		</div>
	</div>
	<nav class="nice-section-nav print:hidden" aria-label={t('nice.categories')}>
		<div class="nice-section-inner">
			{
				navItems.map((item) => (
					<a class:list={{ 'nice-section-link': true, active: item.match(pathname) }} href={localizedPath(item.href, locale)}>
						<NiceIcon name={item.icon} size="1rem" />
						<span>{item.label}</span>
					</a>
				))
			}
		</div>
	</nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.nice-header');
  if (header) {
    const syncHeight = () => document.documentElement.style.setProperty('--sl-nav-height', `${header.getBoundingClientRect().height}px`);
    syncHeight();
    new ResizeObserver(syncHeight).observe(header);
  }
</script>

<style>
	@layer starlight.core {
		.nice-header {
			display: flex;
			flex-direction: column;
			width: 100%;
			min-width: 0;
			background: var(--nice-header-bg, #fc5000);
		}

		.nice-brand-row {
			background: var(--nice-header-bg, #fc5000);
			color: white;
		}

		.nice-brand-inner {
			display: grid;
			grid-template-columns: minmax(0, auto) minmax(0, 1fr);
			align-items: center;
			gap: 1rem;
			min-height: 3.875rem;
			width: 100%;
			padding: 0.625rem var(--nice-shell-edge);
		}

		.title-wrapper {
			overflow: clip;
			min-width: 0;
			padding: 0.25rem;
			margin: -0.25rem;
		}

		.nice-actions,
		.nice-header-controls,
		.nice-social-icons {
			display: flex;
			align-items: center;
		}

		.nice-actions {
			flex-wrap: wrap;
			gap: 0.75rem;
			justify-self: end;
			min-width: 0;
			flex: 1;
			justify-content: flex-end;
		}

		.nice-header-controls {
			gap: 0.75rem;
		}

		.nice-social-icons {
			gap: 0.625rem;
		}

		.nice-shop-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			height: 2.5rem;
			width: 2.5rem;
			padding-inline: 0;
			border: 1px solid rgba(255, 255, 255, 0.9);
			border-radius: 0.5rem;
			color: var(--nice-header-bg, #fc5000);
			font-size: 0.875rem;
			font-weight: 700;
			line-height: 1;
			text-decoration: none;
			white-space: nowrap;
			background: white;
		}

		.nice-shop-icon {
			width: 1.35rem;
			height: 1.35rem;
			background: currentColor;
		}

		.nice-taobao-icon {
			border-radius: 0.1875rem;
			-webkit-mask: url('/assets/ui/taobao.svg') center / contain no-repeat;
			mask: url('/assets/ui/taobao.svg') center / contain no-repeat;
		}

		.nice-onshape-icon {
			width: 1.5rem;
			height: 1.5rem;
			-webkit-mask: url('/assets/ui/onshape.png') center / contain no-repeat;
			mask: url('/assets/ui/onshape.png') center / contain no-repeat;
		}

		.nice-shop-link:hover {
			border-color: white;
			background: rgba(255, 255, 255, 0.88);
			color: var(--nice-header-bg, #fc5000);
			text-decoration: none;
		}

		.nice-section-nav {
			background: var(--nice-section-bg, #ffffff);
			border-block-end: 1px solid var(--sl-color-gray-5);
			box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
		}

		.nice-section-inner {
			display: flex;
			align-items: center;
			gap: 0.35rem;
			width: 100%;
			padding-inline: var(--nice-shell-edge);
			overflow-x: auto;
			scrollbar-width: none;
		}

		.nice-section-inner::-webkit-scrollbar {
			display: none;
		}

		.nice-section-link {
			position: relative;
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			min-height: 2.55rem;
			margin-block: 0.225rem;
			padding-inline: 0.7rem;
			border-radius: 0.45rem;
			color: #786b67;
			font-size: 0.9rem;
			font-weight: 400;
			text-decoration: none;
			white-space: nowrap;
			transition:
				background-color 180ms ease,
				color 180ms ease;
		}

		:root[data-theme='dark'] .nice-section-link {
			color: #b8adaa;
		}

		.nice-section-link:first-child {
			margin-inline-start: -0.7rem;
		}

		.nice-section-link:hover {
			background: rgba(120, 107, 103, 0.1);
			color: #5f5450;
			text-decoration: none;
		}

		:root[data-theme='dark'] .nice-section-link:hover {
			background: rgba(255, 255, 255, 0.07);
			color: var(--sl-color-white);
		}

		.nice-section-link.active {
			background: transparent;
			color: var(--sl-color-text-accent);
			box-shadow: none;
			font-weight: 400;
			text-decoration: none;
		}

		.nice-section-link.active::after {
			content: '';
			position: absolute;
			inset-inline: 0.7rem;
			inset-block-end: -0.225rem;
			height: 2px;
			background: var(--nice-header-bg, #fc5000);
		}

		.nice-section-link.active:hover {
			background-color: rgba(120, 107, 103, 0.1);
			color: var(--sl-color-text-accent);
		}

		:root[data-theme='dark'] .nice-section-link.active {
			color: var(--sl-color-text-accent);
		}

		:root[data-theme='dark'] .nice-section-link.active:hover {
			background-color: rgba(255, 255, 255, 0.07);
			color: var(--sl-color-text-accent);
		}

		@media (max-width: 50rem) {
			.nice-brand-inner {
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 0.75rem;
				min-height: 3.5rem;
			}

			:global(html[data-has-sidebar]) .nice-brand-inner {
				padding-inline-start: calc(var(--nice-shell-edge) + var(--sl-menu-button-size) + 0.75rem);
			}

			.nice-actions {
				gap: 0.5rem;
			}

			.nice-shop-link {
				width: 2.2rem;
				height: 2.2rem;
				font-size: 0.8125rem;
			}

			.nice-section-link {
				min-height: 2.45rem;
				gap: 0.35rem;
				padding-inline: 0.5rem;
				font-size: 0.875rem;
			}

			.nice-section-inner {
				gap: 0.125rem;
				justify-content: flex-start;
				padding-inline: 0.5rem;
			}

			.nice-section-link:first-child {
				margin-inline-start: 0;
			}

		}
		@media (max-width: 40rem) {
			.nice-brand-inner { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; }
			.nice-actions { justify-self: stretch; justify-content: flex-start; gap: 0.4rem; }
			:global(html[data-has-sidebar]) .nice-brand-inner {
				padding-inline-start: var(--nice-shell-edge);
			}
			:global(html[data-has-sidebar]) .title-wrapper {
				margin-inline-start: calc(var(--sl-menu-button-size) + 0.75rem);
			}
		}
	}
</style>
